{
  "name": "dojang",
  "version": "0.1.0",
  "private": true,
  "description": "결재를 받아야만 일할 수 있는 AI 신입사원",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:generate": "npm run generate -w @dojang/db",
    "db:migrate": "npm run migrate -w @dojang/db",
    "db:seed": "npm run seed -w @dojang/db",
    "dev:api": "npm run dev -w @dojang/api",
    "dev:mcp": "npm run dev -w @dojang/mcp-erp",
    "demo": "tsx scripts/demo.ts",
    "dev": "concurrently -n mcp,api,web -c blue,green,magenta \"npm run start:mcp\" \"npm run start:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @dojang/web",
    "build:web": "npm run build -w @dojang/web",
    "start:mcp": "tsx --env-file=.env apps/mcp-erp/src/main.ts",
    "eval": "tsx --env-file=.env evals/run.ts",
    "samples": "tsx scripts/make-samples.ts",
    "start:api": "tsx --env-file=.env apps/api/src/main.ts",
    "record": "tsx --env-file=.env scripts/record-demo.ts",
    "record:setup": "playwright-core install ffmpeg",
    "site": "tsx scripts/build-site.ts"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "marked": "^18.1.3",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
