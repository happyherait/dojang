{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API 서버",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--env-file=.env", "--import", "tsx"],
      "program": "${workspaceFolder}/apps/api/src/main.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "가상 ERP MCP 서버",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--env-file=.env", "--import", "tsx"],
      "program": "${workspaceFolder}/apps/mcp-erp/src/main.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "현재 테스트 파일",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "전체 서버",
      "configurations": ["가상 ERP MCP 서버", "API 서버"],
      "stopAll": true
    }
  ]
}
