# 로컬 개발 기본값. `cp .env.example .env`로 복사해 사용한다.
DATABASE_URL=postgres://dojang:dojang@localhost:5432/dojang
TEST_DATABASE_URL=postgres://dojang:dojang@localhost:5432/dojang_test

# 32자 이상. API와 MCP 서버가 같은 값을 사용한다.
JWT_SECRET=change-me-to-a-random-string-of-32-chars

API_PORT=4000
MCP_PORT=4100

# 데모용 역할 전환 로그인. 운영 환경에서는 켜지 않는다.
DEMO_LOGIN=true
